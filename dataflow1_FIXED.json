{
    "name": "dataflow1",
    "properties": {
        "type": "MappingDataFlow",
        "typeProperties": {
            "sources": [
                {
                    "dataset": {
                        "referenceName": "DS_Sink_EV_SQL",
                        "type": "DatasetReference"
                    },
                    "name": "SourceRawTelemetry"
                }
            ],
            "sinks": [
                {
                    "dataset": {
                        "referenceName": "DS_Staging_EV_SQL",
                        "type": "DatasetReference"
                    },
                    "name": "SinkStaging"
                },
                {
                    "dataset": {
                        "referenceName": "DS_Exceptions_EV_SQL",
                        "type": "DatasetReference"
                    },
                    "name": "SinkExceptions"
                }
            ],
            "transformations": [
                {
                    "name": "RemoveDuplicates"
                },
                {
                    "name": "KeepFirstRow"
                },
                {
                    "name": "HandleNullValues"
                },
                {
                    "name": "SplitCleanAndExceptions"
                },
                {
                    "name": "AddExceptionReason"
                }
            ],
            "scriptLines": [
                "source(output(",
                "          charger_id as string,",
                "          timestamp as timestamp,",
                "          state as string,",
                "          city as string,",
                "          zone as string,",
                "          site_type as string,",
                "          hw_type as string,",
                "          charger_type_category as string,",
                "          max_power_kw as integer,",
                "          status as string,",
                "          is_online as boolean,",
                "          uptime_pct as decimal(5,2),",
                "          user_id as string,",
                "          session_duration_mins as integer,",
                "          session_dur_bucket as string,",
                "          utilisation_pct as decimal(5,2),",
                "          time_of_day_band as string,",
                "          total_active_power_kw as decimal(10,3),",
                "          voltage_phase_a_v as decimal(6,2),",
                "          voltage_phase_b_v as decimal(6,2),",
                "          voltage_phase_c_v as decimal(6,2),",
                "          current_phase_a_a as decimal(6,2),",
                "          current_phase_b_a as decimal(6,2),",
                "          current_phase_c_a as decimal(6,2),",
                "          connector_temp_c as decimal(5,2),",
                "          ambient_temp_c as decimal(5,2),",
                "          energy_delivered_kwh as decimal(10,3),",
                "          session_revenue_inr as decimal(10,2),",
                "          electricity_cost_inr as decimal(10,2),",
                "          maintenance_cost_inr as decimal(10,2),",
                "          connectivity_cost_inr as decimal(10,2),",
                "          staff_cost_inr as decimal(10,2),",
                "          net_margin_inr as decimal(10,2),",
                "          lost_revenue_inr as decimal(10,4),",
                "          initial_soc_pct as decimal(5,2),",
                "          current_soc_pct as decimal(5,2),",
                "          target_soc_pct as decimal(5,2),",
                "          error_code as string,",
                "          fault_severity as string,",
                "          is_faulted as boolean,",
                "          repeat_fault as boolean,",
                "          mttr_estimate_mins as integer,",
                "          downtime_mins_today as integer,",
                "          customers_lost as decimal(5,2),",
                "          fault_lost_revenue_inr as decimal(10,4),",
                "          zone_score as decimal(5,4),",
                "          peak_hour as boolean",
                "     ),",
                "     allowSchemaDrift: true,",
                "     validateSchema: false,",
                "     isolationLevel: 'READ_UNCOMMITTED',",
                "     query: 'SELECT * FROM dbo.raw_ev_telemetry',",
                "     format: 'query') ~> SourceRawTelemetry",
                "SourceRawTelemetry window(over(charger_id,",
                "          timestamp),",
                "     desc(timestamp, true),",
                "     row_num = rowNumber()) ~> RemoveDuplicates",
                "RemoveDuplicates filter(row_num == 1) ~> KeepFirstRow",
                "KeepFirstRow derive(state = iifNull(state, 'UNKNOWN'),",
                "          city = iifNull(city, 'UNKNOWN'),",
                "          zone = iifNull(zone, 'UNKNOWN'),",
                "          site_type = iifNull(site_type, 'UNKNOWN'),",
                "          hw_type = iifNull(hw_type, 'UNKNOWN'),",
                "          charger_type_category = iifNull(charger_type_category, 'UNKNOWN'),",
                "          status = iifNull(status, 'UNKNOWN'),",
                "          user_id = iifNull(user_id, 'UNKNOWN'),",
                "          session_dur_bucket = iifNull(session_dur_bucket, 'UNKNOWN'),",
                "          time_of_day_band = iifNull(time_of_day_band, 'UNKNOWN'),",
                "          error_code = iifNull(error_code, 'NONE'),",
                "          fault_severity = iifNull(fault_severity, 'NONE'),",
                "          energy_delivered_kwh = iifNull(energy_delivered_kwh, 0),",
                "          session_revenue_inr = iifNull(session_revenue_inr, 0),",
                "          electricity_cost_inr = iifNull(electricity_cost_inr, 0),",
                "          maintenance_cost_inr = iifNull(maintenance_cost_inr, 0),",
                "          connectivity_cost_inr = iifNull(connectivity_cost_inr, 0),",
                "          staff_cost_inr = iifNull(staff_cost_inr, 0),",
                "          net_margin_inr = iifNull(net_margin_inr, 0),",
                "          lost_revenue_inr = iifNull(lost_revenue_inr, 0),",
                "          fault_lost_revenue_inr = iifNull(fault_lost_revenue_inr, 0),",
                "          max_power_kw = iifNull(max_power_kw, 0),",
                "          session_duration_mins = iifNull(session_duration_mins, 0),",
                "          uptime_pct = iifNull(uptime_pct, 0),",
                "          utilisation_pct = iifNull(utilisation_pct, 0),",
                "          total_active_power_kw = iifNull(total_active_power_kw, 0),",
                "          voltage_phase_a_v = iifNull(voltage_phase_a_v, 0),",
                "          voltage_phase_b_v = iifNull(voltage_phase_b_v, 0),",
                "          voltage_phase_c_v = iifNull(voltage_phase_c_v, 0),",
                "          current_phase_a_a = iifNull(current_phase_a_a, 0),",
                "          current_phase_b_a = iifNull(current_phase_b_a, 0),",
                "          current_phase_c_a = iifNull(current_phase_c_a, 0),",
                "          connector_temp_c = iifNull(connector_temp_c, 0),",
                "          ambient_temp_c = iifNull(ambient_temp_c, 0),",
                "          initial_soc_pct = iifNull(initial_soc_pct, 0),",
                "          current_soc_pct = iifNull(current_soc_pct, 0),",
                "          target_soc_pct = iifNull(target_soc_pct, 0),",
                "          mttr_estimate_mins = iifNull(mttr_estimate_mins, 0),",
                "          downtime_mins_today = iifNull(downtime_mins_today, 0),",
                "          customers_lost = iifNull(customers_lost, 0),",
                "          zone_score = iifNull(zone_score, 0),",
                "          is_online = iifNull(is_online, false()),",
                "          is_faulted = iifNull(is_faulted, false()),",
                "          repeat_fault = iifNull(repeat_fault, false()),",
                "          peak_hour = iifNull(peak_hour, false())) ~> HandleNullValues",
                "HandleNullValues split(!isNull(charger_id) && !isNull(timestamp) && ",
                "(isNull(energy_delivered_kwh) || energy_delivered_kwh >= 0) && ",
                "(isNull(connector_temp_c) || (connector_temp_c >= -30 && connector_temp_c <= 150)),",
                "     disjoint: false) ~> SplitCleanAndExceptions@(ValidData, InvalidData)",
                "SplitCleanAndExceptions@InvalidData derive(ExceptionReason = 'Missing ID or Sensor Values Out of Bounds') ~> AddExceptionReason",
                "SplitCleanAndExceptions@ValidData sink(allowSchemaDrift: true,",
                "     validateSchema: false,",
                "     input(",
                "          charger_id as string,",
                "          timestamp as timestamp,",
                "          state as string,",
                "          city as string,",
                "          zone as string,",
                "          site_type as string,",
                "          hw_type as string,",
                "          charger_type_category as string,",
                "          max_power_kw as integer,",
                "          status as string,",
                "          is_online as boolean,",
                "          uptime_pct as decimal(5,2),",
                "          user_id as string,",
                "          session_duration_mins as integer,",
                "          session_dur_bucket as string,",
                "          utilisation_pct as decimal(5,2),",
                "          time_of_day_band as string,",
                "          total_active_power_kw as decimal(10,3),",
                "          voltage_phase_a_v as decimal(6,2),",
                "          voltage_phase_b_v as decimal(6,2),",
                "          voltage_phase_c_v as decimal(6,2),",
                "          current_phase_a_a as decimal(6,2),",
                "          current_phase_b_a as decimal(6,2),",
                "          current_phase_c_a as decimal(6,2),",
                "          connector_temp_c as decimal(5,2),",
                "          ambient_temp_c as decimal(5,2),",
                "          energy_delivered_kwh as decimal(10,3),",
                "          session_revenue_inr as decimal(10,2),",
                "          electricity_cost_inr as decimal(10,2),",
                "          maintenance_cost_inr as decimal(10,2),",
                "          connectivity_cost_inr as decimal(10,2),",
                "          staff_cost_inr as decimal(10,2),",
                "          net_margin_inr as decimal(10,2),",
                "          lost_revenue_inr as decimal(10,4),",
                "          initial_soc_pct as decimal(5,2),",
                "          current_soc_pct as decimal(5,2),",
                "          target_soc_pct as decimal(5,2),",
                "          error_code as string,",
                "          fault_severity as string,",
                "          is_faulted as boolean,",
                "          repeat_fault as boolean,",
                "          mttr_estimate_mins as integer,",
                "          downtime_mins_today as integer,",
                "          customers_lost as decimal(5,2),",
                "          fault_lost_revenue_inr as decimal(10,4),",
                "          zone_score as decimal(5,4),",
                "          peak_hour as boolean",
                "     ),",
                "     deletable:false,",
                "     insertable:true,",
                "     updateable:false,",
                "     upsertable:false,",
                "     truncate:true,",
                "     format: 'table',",
                "     skipDuplicateMapInputs: true,",
                "     skipDuplicateMapOutputs: true,",
                "     errorHandlingOption: 'stopOnFirstError') ~> SinkStaging",
                "AddExceptionReason sink(allowSchemaDrift: true,",
                "     validateSchema: false,",
                "     input(",
                "          charger_id as string,",
                "          timestamp as timestamp,",
                "          state as string,",
                "          city as string,",
                "          zone as string,",
                "          site_type as string,",
                "          hw_type as string,",
                "          charger_type_category as string,",
                "          max_power_kw as integer,",
                "          status as string,",
                "          is_online as boolean,",
                "          uptime_pct as decimal(5,2),",
                "          user_id as string,",
                "          session_duration_mins as integer,",
                "          session_dur_bucket as string,",
                "          utilisation_pct as decimal(5,2),",
                "          time_of_day_band as string,",
                "          total_active_power_kw as decimal(10,3),",
                "          voltage_phase_a_v as decimal(6,2),",
                "          voltage_phase_b_v as decimal(6,2),",
                "          voltage_phase_c_v as decimal(6,2),",
                "          current_phase_a_a as decimal(6,2),",
                "          current_phase_b_a as decimal(6,2),",
                "          current_phase_c_a as decimal(6,2),",
                "          connector_temp_c as decimal(5,2),",
                "          ambient_temp_c as decimal(5,2),",
                "          energy_delivered_kwh as decimal(10,3),",
                "          session_revenue_inr as decimal(10,2),",
                "          electricity_cost_inr as decimal(10,2),",
                "          maintenance_cost_inr as decimal(10,2),",
                "          connectivity_cost_inr as decimal(10,2),",
                "          staff_cost_inr as decimal(10,2),",
                "          net_margin_inr as decimal(10,2),",
                "          lost_revenue_inr as decimal(10,4),",
                "          initial_soc_pct as decimal(5,2),",
                "          current_soc_pct as decimal(5,2),",
                "          target_soc_pct as decimal(5,2),",
                "          error_code as string,",
                "          fault_severity as string,",
                "          is_faulted as boolean,",
                "          repeat_fault as boolean,",
                "          mttr_estimate_mins as integer,",
                "          downtime_mins_today as integer,",
                "          customers_lost as decimal(5,2),",
                "          fault_lost_revenue_inr as decimal(10,4),",
                "          zone_score as decimal(5,4),",
                "          peak_hour as boolean,",
                "          ExceptionReason as string",
                "     ),",
                "     deletable:false,",
                "     insertable:true,",
                "     updateable:false,",
                "     upsertable:false,",
                "     format: 'table',",
                "     skipDuplicateMapInputs: true,",
                "     skipDuplicateMapOutputs: true,",
                "     errorHandlingOption: 'stopOnFirstError') ~> SinkExceptions"
            ]
        }
    }
}
