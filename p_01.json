                        "value": "@if(equals(pipeline().parameters.pipeline_date, ''), formatDateTime(adddays(utcnow(), -1), 'yyyy-MM-dd'), pipeline().parameters.pipeline_date)",
                        "type": "Expression"
                    }
                }
            },
            {
