                    "source": {
                        "type": "AzureSqlSource",
                        "sqlReaderQuery": {
                            "value": "SELECT COUNT(*) AS ExistingCount\nFROM dbo.raw_ev_telemetry\nWHERE CAST(timestamp AS DATE) = '@{variables('v_pipeline_date')}';",
